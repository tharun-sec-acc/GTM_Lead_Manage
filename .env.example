DATABASE_URL=postgresql+psycopg://prospecting:prospecting@db:5432/prospecting
REDIS_URL=redis://redis:6379/0
APOLLO_API_KEY=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
AWS_REGION=
BEDROCK_MODEL_ID=
# Optional S3 archive for meeting recordings/transcripts. Without it artifacts stay on the local volume.
AWS_S3_BUCKET=gtmprospecting-meeting-artifacts
AWS_S3_UPLOAD_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Company intelligence is opt-in. Research is limited to public, unauthenticated sites.
COMPANY_INTELLIGENCE_ENABLED=false
RESEARCH_BROWSER_ENABLED=false
RESEARCH_BROWSER_WAIT_MS=10000
RESEARCH_SEARCH_PROVIDER=
RESEARCH_SEARCH_API_KEY=
RESEARCH_MAX_CONCURRENT_AGENTS=3
RESEARCH_MAX_PAGES_PER_COMPANY=12
RESEARCH_MAX_CRAWL_DEPTH=5
RESEARCH_REQUEST_TIMEOUT=12
RESEARCH_MAX_DURATION_SECONDS=120
RESEARCH_CACHE_TTL_HOURS=24
RESEARCH_MAX_RETRIES=2
RESEARCH_MAX_CONTENT_SIZE=2000000
RESEARCH_MAX_TOTAL_CONTENT_SIZE=8000000
RESEARCH_DAILY_BUDGET=100
RESEARCH_DAILY_BEDROCK_CALLS=500
RESEARCH_DAILY_SOURCE_BYTES=50000000
# Keyless discovery adapters and bounds.
RESEARCH_DISCOVERY_ENABLED=true
RESEARCH_DISCOVERY_MAX_CANDIDATES=30
RESEARCH_DISCOVERY_MAX_DOMAINS=12
RESEARCH_DISCOVERY_MAX_CANDIDATES_PER_DOMAIN=4
RESEARCH_DISCOVERY_MIN_SCORE=0.45
RESEARCH_DISCOVERY_MAX_BYTES=4000000
RESEARCH_DISCOVERY_DEADLINE_SECONDS=90
RESEARCH_DISCOVERY_WIKIPEDIA_ENABLED=true
RESEARCH_DISCOVERY_SEC_ENABLED=true
RESEARCH_DISCOVERY_GLEIF_ENABLED=true
# Set approved AWS credentials in the runtime environment or use an approved role/profile.
# Host AWS credentials are not automatically available inside Docker containers.
MAIL_SEND_ENABLED=false
# Disable only after approving outreach without unsubscribe links.
MAIL_UNSUBSCRIBE_ENABLED=true
TRACKING_ENABLED=false
PUBLIC_BASE_URL=
DAILY_SEND_LIMIT=50
# Registration / Microsoft Entra Web App
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/microsoft/oauth/callback
MICROSOFT_ORGANIZER_EMAIL=
MICROSOFT_TOKEN_ENCRYPTION_KEY=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Google Workspace / OAuth Web App
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/oauth/callback
GOOGLE_WORKSPACE_ORGANIZER_EMAIL=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_MEET_ENABLED=true
GOOGLE_DRIVE_ENABLED=true
GOOGLE_WORKSPACE_EVENTS_ENABLED=false

# Zoho CRM OAuth Integration
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/zoho/oauth/callback
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_CRM_API_VERSION=v8
ZOHO_TOKEN_ENCRYPTION_KEY=
ZOHO_SYNC_ENABLED=true

# Multi-Tenant SaaS & Authentication
# Replace JWT_SECRET_KEY with a private random 32+ character value before any shared use.
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-char-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
DEFAULT_ORG_NAME=Acme Corporation
DEFAULT_ORG_SLUG=acme-corp
AUTH_ENABLED=true
# Must stay false for any deployment that requires sign-in.
AUTH_ALLOW_ANONYMOUS_FALLBACK=false
# Billing and plan entitlements. Plans, prices and limits live in the database.
BILLING_DEFAULT_PLAN_CODE=growth
BILLING_CURRENCY=INR
# Set false to report metered usage without blocking actions.
BILLING_ENFORCE_LIMITS=true

# Advertising & Lead Capture (Release 3)
# Kill switches: ADVERTISING_ENABLED covers connectors and public capture.
ADVERTISING_ENABLED=true
ADVERTISING_SYNC_ENABLED=true
# Meta Marketing API + Lead Ads. Sync reports "not configured" while these are empty.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# Google Ads. The developer token needs Google's API-access approval before live calls work.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v19
# Shared key echoed by Google on lead-form deliveries.
GOOGLE_LEAD_FORM_KEY=

# Unified Meeting Management Settings
MEETING_TIMEZONE=UTC
MEETING_DURATION_MINUTES=30
MEETING_WORKDAY_START_HOUR=9
MEETING_WORKDAY_END_HOUR=17
MEETING_BOOKING_WINDOW_DAYS=30